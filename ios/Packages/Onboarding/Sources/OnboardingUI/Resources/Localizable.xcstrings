    "welcome.deadpan.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh. You came"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哦，来了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "喔，來了"
          }
        }
      }
    },
    "welcome.deadpan.10": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome. Don't out-train me"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎，别卷我"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎，別太拚喔"
          }
        }
      }
    },
    "welcome.deadpan.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sit. Anywhere"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐，随便坐"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "坐，隨便坐"
          }
        }
      }
    },
    "welcome.deadpan.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One more to train with"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "又多一个陪练的"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "又多一個陪練的"
          }
        }
      }
    },
    "welcome.deadpan.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome. No need to try too hard"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎，不用太努力"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎，不用太努力"
          }
        }
      }
    },
    "welcome.deadpan.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nice. Everyone's here"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挺好，人齐了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不錯，人到齊了"
          }
        }
      }
    },
    "welcome.deadpan.6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mm. Showing up counts"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "嗯，来了就行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "嗯，來了就好"
          }
        }
      }
    },
    "welcome.deadpan.7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome. Your own pace"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎，按自己节奏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎，照自己的節奏"
          }
        }
      }
    },
    "welcome.deadpan.8": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take it slow. No rush"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢慢来，不急"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慢慢來，不急"
          }
        }
      }
    },
    "welcome.deadpan.9": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here? That's nice"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来了？那挺好"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來了？那不錯"
          }
        }
      }
    },
    "welcome.drama.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've waited my whole life for this"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一刻我等了一辈子"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這一刻我等了一輩子"
          }
        }
      }
    },
    "welcome.drama.10": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This goes in the diary"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天值得写进日记"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天值得寫進日記"
          }
        }
      }
    },
    "welcome.drama.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A meeting of destiny"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命运的相遇"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "命運的相遇"
          }
        }
      }
    },
    "welcome.drama.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I declare the squad complete"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我宣布，小队完整了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我宣布，小隊完整了"
          }
        }
      }
    },
    "welcome.drama.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The script said you'd come"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "剧本里说你会来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "劇本裡說你會來"
          }
        }
      }
    },
    "welcome.drama.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too excited to keep a straight face"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "激动到表情管理失败"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "激動到表情管理失敗"
          }
        }
      }
    },
    "welcome.drama.6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I wouldn't allow you not to come"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我不允许你不来"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我不允許你不來"
          }
        }
      }
    },
    "welcome.drama.7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tears. Finally, you're here"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "泪，终于等到你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "淚，終於等到你"
          }
        }
      }
    },
    "welcome.drama.8": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What a dream teammate"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是什么神仙队友"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這是什麼神隊友"
          }
        }
      }
    },
    "welcome.drama.9": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick, pass me a tissue"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快，给我递纸巾"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快，給我衛生紙"
          }
        }
      }
    },
    "welcome.energetic.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finally, someone to grind with"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终于有人陪我卷了"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "終於有人陪我拚了"
          }
        }
      }
    },
    "welcome.energetic.10": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full battery, all for you"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体力满格欢迎你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "體力滿格歡迎你"
          }
        }
      }
    },
    "welcome.energetic.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rookie! Two laps, go!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新兵！先跑两圈！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "菜鳥！先跑兩圈！"
          }
        }
      }
    },
    "welcome.energetic.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start training today?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天就开练？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天就開練？"
          }
        }
      }
    },
    "welcome.energetic.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No leaving now"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来了就别想走"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來了就別想走"
          }
        }
      }
    },
    "welcome.energetic.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm-up ready!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热身已就位！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暖身已就位！"
          }
        }
      }
    },
    "welcome.energetic.6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High five!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "击个掌！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來，擊掌！"
          }
        }
      }
    },
    "welcome.energetic.7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More of us, more energy!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人多练得更起劲！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "人多練得更起勁！"
          }
        }
      }
    },
    "welcome.energetic.8": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomorrow? Any time works"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明天几点？我都行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "明天幾點？我都可以"
          }
        }
      }
    },
    "welcome.energetic.9": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome! Let's go go go!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎！走走走！"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎！走走走！"
          }
        }
      }
    },
