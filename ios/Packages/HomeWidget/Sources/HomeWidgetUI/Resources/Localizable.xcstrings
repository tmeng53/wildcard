      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squad goal"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小隊本週目標"
          }
        }
      }
    },
