{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "我的一周": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My week"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我的一週"
          }
        }
      }
    },
    "天": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "days"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "天"
          }
        }
      }
    },
    "今天练了": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trained today"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天練了"
          }
        }
      }
    },
    "今天请假": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day off today"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天請假"
          }
        }
      }
    },
    "今天还没练": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not yet today"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天還沒練"
          }
        }
      }
    },
    "%lld/%lld 天，%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld days, %3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld 天，%3$@"
          }
        }
      }
    },
    "小队本周目标": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squad goal"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小隊本週目標"
          }
        }
      }
    },
    "打卡": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check in"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打卡"
          }
        }
      }
    },
    "已打卡": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked in"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已打卡"
          }
        }
      }
    },
    "今天 %lld/%lld": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today %1$lld/%2$lld"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天 %1$lld/%2$lld"
          }
        }
      }
    },
    "小队今天": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squad today"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小隊今天"
          }
        }
      }
    },
    "本周练了几天": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your days trained this week"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週練了幾天"
          }
        }
      }
    },
    "今天谁练了": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Who trained today"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天誰練了"
          }
        }
      }
    },
    "还没加入小队": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not in a squad yet"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒加入小隊"
          }
        }
      }
    },
    "还没登录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not signed in"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "還沒登入"
          }
        }
      }
    },
    "暂时连不上": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't connect"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時連不上"
          }
        }
      }
    },
    "次": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "workouts"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "次"
          }
        }
      }
    },
    "桌面小组件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Home Screen Widgets"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "主畫面小工具"
          }
        }
      }
    },
    "不用打开 App，也能看到这周练了几天、小队今天谁练了。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your week and who in your squad trained today without opening the app."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不用打開 App，也能看到這週練了幾天、小隊今天誰練了。"
          }
        }
      }
    },
    "怎么加": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How to add"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "怎麼加"
          }
        }
      }
    },
    "回到桌面，长按空白处，直到图标开始晃": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your Home Screen, touch and hold an empty spot until the apps jiggle"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回到主畫面，長按空白處，直到圖示開始晃動"
          }
        }
      }
    },
    "点左上角「编辑」，再点「添加小组件」": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Edit in the top-left corner, then Add Widget"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點左上角「編輯」，再點「加入小工具」"
          }
        }
      }
    },
    "搜「外卡」，选大小，点「添加小组件」": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search for “Wildcard”, pick a size, then tap Add Widget"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋「外卡」，選大小，點「加入小工具」"
          }
        }
      }
    },
    "小号、中号都有": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small and medium"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小型、中型都有"
          }
        }
      }
    }
  },
  "version": "1.0"
}
