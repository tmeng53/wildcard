{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "我的一周": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My week"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我的一週"
          }
        }
      }
    },
    "天": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "days"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "天"
          }
        }
      }
    },
    "今天练了": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trained today"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天練了"
          }
        }
      }
    },
    "今天请假": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day off today"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天請假"
          }
        }
      }
    },
    "今天还没练": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not yet today"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天還沒練"
          }
        }
      }
    },
    "%lld/%lld 天，%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld days, %3$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld/%2$lld 天，%3$@"
          }
        }
      }
    },
