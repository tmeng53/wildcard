    "想看本周出赛表：长按小组件，点「编辑小组件」换": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For this week's lineup, touch and hold the widget, tap “Edit Widget” and switch."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想看本週出賽表：長按小工具，點「編輯小工具」換"
          }
        }
      }
    },
