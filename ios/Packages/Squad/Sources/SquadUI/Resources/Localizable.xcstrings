  "strings": {
    "%@ 选的，下周冠军再换": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@'s pick. Next week's champ gets the next one."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 選的，下週冠軍再換"
          }
