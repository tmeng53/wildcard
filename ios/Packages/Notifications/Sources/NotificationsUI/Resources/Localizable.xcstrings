{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@ 把小队搬到了%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ moved the squad to %2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 把小隊搬到了%2$@"
          }
        }
      }
    },
