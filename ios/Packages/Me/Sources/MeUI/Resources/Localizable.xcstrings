{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "你会离开%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll leave %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你會離開%@"
          }
        }
      }
    },
    "先不注销": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先不要刪除"
          }
        }
      }
    },
    "再试一次": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "再試一次"
          }
        }
      }
    },
    "删了就找不回来了。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once it's gone, it can't come back."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪了就找不回來了。"
          }
        }
      }
    },
    "周三不练腿俱乐部": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip Leg Day Club"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "週三不練腿俱樂部"
          }
        }
      }
    },
    "小林": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lin"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小林"
          }
        }
      }
    },
    "往期战报": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past recaps"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "過往戰報"
          }
        }
      }
    },
    "我的小队": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My squad"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我的小隊"
          }
        }
      }
    },
    "所有打卡、照片和请假条会删掉": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All your check-ins, photos and day-off notes go"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有打卡、照片和假單都會刪除"
          }
        }
      }
    },
    "正在注销…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleting…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在刪除…"
          }
        }
      }
    },
    "注销账号": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete account"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "刪除帳號"
          }
        }
      }
    },
    "用 Apple 确认注销": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm with Apple"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Apple 確認刪除"
          }
        }
      }
    },
