            "value": "Wednesdays Only"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "週三限定"
          }
        }
      }
    },
    "深夜举铁人": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Midnight Lifter"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "深夜舉鐵人"
          }
        }
      }
    },
    "连着五天七点前打卡。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked in before 7am five days running."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連著五天七點前打卡。"
          }
        }
      }
    },
    "练完一句话不说，表情比杠铃还沉。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not a word after training, a face heavier than the bar."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "練完一句話不說，表情比槓鈴還沉。"
          }
        }
      }
    },
    "一整周没发一个表情。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not one emoji all week."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一整週沒發一個表情。"
          }
        }
      }
    },
    "请假条写成了连载。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turned day-off notes into a serial."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "假單寫成了連載。"
          }
        }
      }
    },
    "五顿健康餐，一顿没破。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Five clean meals, not one slip."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "五頓健康餐，一頓沒破。"
          }
        }
      }
    },
    "累了就休息，睡够八小时。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rested when tired and slept eight hours."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "累了就休息，睡夠八小時。"
          }
        }
      }
    },
    "按时吃饭。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ate on time."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按時吃飯。"
          }
        }
      }
    },
