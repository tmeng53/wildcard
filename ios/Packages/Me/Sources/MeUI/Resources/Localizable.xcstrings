      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gave yourself a day off."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給自己放了個假。"
          }
        }
      }
    },
