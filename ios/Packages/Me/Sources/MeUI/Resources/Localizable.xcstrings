    "给 AI 的同意也一起撤回": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your consent to the AI is withdrawn too"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "給 AI 的同意也會一起撤回"
          }
        }
      }
    },
    "编辑外卡运动员": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit your Wildcard athlete"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯外卡運動員"
