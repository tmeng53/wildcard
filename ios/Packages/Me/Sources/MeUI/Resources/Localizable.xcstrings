      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only shows up on Wednesdays, and then runs 10K."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在週三出現，一出現就是十公里。"
          }
        }
      }
    },
    "晚上十一点还在卧推。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Still benching at 11pm."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "晚上十一點還在臥推。"
          }
