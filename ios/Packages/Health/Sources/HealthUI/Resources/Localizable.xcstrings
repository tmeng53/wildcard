          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Health"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple 健康"
          }
        }
      }
    },
    "发到小队时默认带上" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shared with your squad by default"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "發到小隊時默認帶上"
          }
        }
      }
    },
    "在 iOS 设置里管理读取权限" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manage reading access in iOS Settings"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 iOS 設定裡管理讀取權限"
