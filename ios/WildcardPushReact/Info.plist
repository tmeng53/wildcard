<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Where the hosted backend is, as in the app's Info.plist: reacting goes through our API. -->
	<key>WildcardAPIURL</key>
	<string>$(WILDCARD_API_URL)</string>
	<key>WildcardAuthURL</key>
	<string>$(WILDCARD_AUTH_URL)</string>
	<key>WildcardAuthPublishableKey</key>
	<string>$(WILDCARD_AUTH_PUBLISHABLE_KEY)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<!-- The 6pm push (the API's dailyProgress category). -->
			<key>UNNotificationExtensionCategory</key>
			<string>dailyProgress</string>
			<key>UNNotificationExtensionInitialContentSizeRatio</key>
			<real>1.2</real>
			<!-- The view shows the week itself, so the push's own words are hidden under it. -->
			<key>UNNotificationExtensionDefaultContentHidden</key>
			<true/>
			<!-- Taps react in place instead of opening the app. -->
			<key>UNNotificationExtensionUserInteractionEnabled</key>
			<true/>
		</dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.usernotifications.content-extension</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).NotificationViewController</string>
	</dict>
</dict>
</plist>
