<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys the generated Info.plist can't set. Chinese first, English second. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>en</string>
	</array>
	<!-- Where the hosted backend is, from build settings. Empty until it is deployed: the app then
	     runs on the sample squad, or with `-local-backend` in Debug on this Mac's local one. -->
	<key>WildcardAPIURL</key>
	<string>$(WILDCARD_API_URL)</string>
	<key>WildcardAuthURL</key>
	<string>$(WILDCARD_AUTH_URL)</string>
	<key>WildcardAuthPublishableKey</key>
	<string>$(WILDCARD_AUTH_PUBLISHABLE_KEY)</string>
	<!-- Plain HTTP to this Mac's local backend from the simulator; every other host stays HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
