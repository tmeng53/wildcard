<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys the generated Info.plist can't set. Simplified Chinese first, then Traditional, then English. -->
	<key>CFBundleLocalizations</key>
	<array>
		<string>zh-Hans</string>
		<string>zh-Hant</string>
		<string>en</string>
	</array>
	<!-- Where the hosted backend is, from build settings: Release (TestFlight, the App Store)
	     names it; Debug leaves it empty and runs on the sample squad, as UI tests need, or with
	     `-local-backend` on this Mac's local one. -->
	<key>WildcardAPIURL</key>
	<string>$(WILDCARD_API_URL)</string>
	<key>WildcardAuthURL</key>
	<string>$(WILDCARD_AUTH_URL)</string>
	<key>WildcardAuthPublishableKey</key>
	<string>$(WILDCARD_AUTH_PUBLISHABLE_KEY)</string>
	<!-- Where crash reports go (CrashReports.swift): Sentry's DSN for the iOS project, which is
	     public by design. Empty, as in Debug, reports nothing. -->
	<key>WildcardSentryDSN</key>
	<string>$(WILDCARD_SENTRY_DSN)</string>
	<!-- wildcard://widget/…: where a tap on a home screen widget opens the app (WidgetLink). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.wildcardsquad.wildcard.widget</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>wildcard</string>
			</array>
		</dict>
	</array>
	<!-- Plain HTTP to this Mac's local backend from the simulator; every other host stays HTTPS. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- The launch screen: the launch cover's graphite with the logo at rest, the same size and
	     place (LaunchCover.swift), so the app opens without a white frame. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchMark</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<false/>
	</dict>
	<!-- Approximate location only, for the coach's weather: iOS never offers precise location. -->
	<key>NSLocationDefaultAccuracyReduced</key>
	<true/>
	<!-- 添加位置 asks once a session for precise location to list nearby places; said no, the
	     approximate one. The words are in InfoPlist.xcstrings under the purpose key. -->
	<key>NSLocationTemporaryUsageDescriptionDictionary</key>
	<dict>
		<key>NearbyPlaces</key>
		<string>To list the places near you when you add a location to a post. Only the place you pick is shared.</string>
	</dict>
	<!-- The app uses only the encryption built into iOS (HTTPS), which is exempt, so App Store
	     Connect doesn't ask about export compliance on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
