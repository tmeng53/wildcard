<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications. Xcode signs development builds with this; exporting for TestFlight
	     and the App Store switches it to production. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Sign in with Apple, the app's only sign-in. -->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Shared with the 6pm push's view (WildcardPushReact): the sign-in (an app group is also a
	     Keychain access group), the squad's looks and where to open the app; and with it and
	     WildcardPushService, the language picked in the app. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.wildcardsquad.wildcard</string>
	</array>
</dict>
</plist>
