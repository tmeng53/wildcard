{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "NearbyPlaces" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To list the places near you when you add a location to a post. Only the place you pick is shared."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "给动态添加位置时，列出你附近的地点。只会分享你选的地点。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為動態新增位置時，列出你附近的地點。只會分享你選的地點。"
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your coach checks the weather where you are to help plan your training."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "教练会看你那边的天气，帮你安排训练。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "教練會看你那邊的天氣，幫你安排訓練。"
          }
        }
      }
    },
    "CFBundleDisplayName" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wildcard"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外卡"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外卡"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Take a photo for your post."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍照发动态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拍照發動態。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reads your workouts in Apple Health to fill in a post's time, distance, heart rate, calories and route. Never reads weight or sleep."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "读取你在 Apple 健康里的运动，发训练时帮你填好时长、距离、心率、卡路里和路线。不读取体重和睡眠。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讀取你在 Apple 健康裡的運動，發訓練時幫你填好時長、距離、心率、卡路里和路線。不讀取體重和睡眠。"
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wildcard never writes anything to Apple Health. It only reads your workouts."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wildcard 不会往 Apple 健康里写入任何数据，只读取你的运动。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wildcard 不會往 Apple 健康裡寫入任何資料，只讀取你的運動。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save puts your weekly schedule poster or weekly recap in your photo library."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存图时把出赛表海报和战报存到你的相册。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "存圖時把出賽表海報和戰報存到你的相簿。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}
