{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "小队": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squad"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "小隊"
          }
        }
      }
    },
    "动态": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "動態"
          }
        }
      }
    },
    "我": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Me"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我"
          }
        }
      }
    },
    "push.coach.note": {
      "comment": "Push notification (APNs loc-key); the API sends the coach's name and the note, which only the app shows, never the lock screen.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sent you a message"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@给你发了一条消息"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@給你發了一則訊息"
          }
        }
      }
    },
    "push.comment": {
      "comment": "Push notification (APNs loc-key); the API sends the arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ commented: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 评论了你：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 在你的動態留言：%2$@"
          }
        }
      }
    },
    "push.comment.mention": {
      "comment": "Push notification (APNs loc-key); the API sends the arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ mentioned you: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ @了你：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ @了你：%2$@"
          }
        }
      }
    },
    "push.comment.reply": {
      "comment": "Push notification (APNs loc-key); the API sends the arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ replied to you: %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 回复了你：%2$@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 回覆了你：%2$@"
          }
        }
      }
    },
    "push.dailyProgress": {
      "comment": "Push notification (APNs loc-key); the API sends the arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squad's at %1$@/%2$@ days this week"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周小队已练 %1$@/%2$@ 天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週小隊已練 %1$@/%2$@ 天"
          }
        }
      }
    },
    "push.dailyProgress.received": {
      "comment": "Push notification (APNs loc-key); the API sends the arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squad's at %1$@/%2$@ days this week · cheers from %3$@ teammates today"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周小队已练 %1$@/%2$@ 天 · 今天 %3$@ 位队友给你打了气"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週小隊已練 %1$@/%2$@ 天 · 今天有 %3$@ 位隊友幫你加油"
          }
        }
      }
    },
    "push.dailyProgress.poke": {
      "comment": "Push notification (APNs loc-key); the API sends the arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ gave you a pat · squad's at %1$@/%2$@ days this week"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@拍了拍你 · 本周小队已练 %1$@/%2$@ 天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@拍了拍你 · 本週小隊已練 %1$@/%2$@ 天"
          }
        }
      }
    },
    "push.dailyProgress.poke.more": {
      "comment": "Push notification (APNs loc-key); the API sends the arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ and %4$@ more gave you a pat · squad's at %1$@/%2$@ days this week"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@和另外 %4$@ 人拍了拍你 · 本周小队已练 %1$@/%2$@ 天"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@和另外 %4$@ 人拍了拍你 · 本週小隊已練 %1$@/%2$@ 天"
          }
        }
      }
    },
    "push.weeklyAwards.ready": {
      "comment": "Push notification (APNs loc-key); the API sends the arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your weekly recap is in. Come see this week's awards"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周战报出炉了，快来看看这周的颁奖"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每週戰報出爐了，快來看看這週的頒獎"
          }
        }
      }
    },
    "push.weeklyAwards.stuck": {
      "comment": "Push notification (APNs loc-key); the API sends the arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@'s awards are stuck: %2$@ tries, last one %3$@. Time to top up"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的本周颁奖卡住了：试了 %2$@ 次，最后一次是 %3$@。去充个值吧"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的本週頒獎卡住了：試了 %2$@ 次，最後一次是 %3$@。去儲值吧"
          }
        }
      }
    },
    "你已不在 %@ 小队": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're no longer in %@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已不在 %@ 小隊"
          }
        }
      }
    },
    "确认": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確認"
          }
        }
      }
    },
    "结束预览": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "End preview"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結束預覽"
          }
        }
      }
    },
    "今天给你的消息": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's message for you"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天給你的訊息"
          }
        }
      }
    }
  },
  "version": "1.0"
}
