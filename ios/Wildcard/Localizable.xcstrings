    "push.dailyProgress": {
      "comment": "Push notification (APNs loc-key); the API sends the arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squad's at %1$@/%2$@ this week"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周小队已练 %1$@/%2$@ 次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週小隊已練 %1$@/%2$@ 次"
          }
        }
      }
    },
    "push.dailyProgress.received": {
      "comment": "Push notification (APNs loc-key); the API sends the arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Squad's at %1$@/%2$@ this week · cheers from %3$@ teammates today"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周小队已练 %1$@/%2$@ 次 · 今天 %3$@ 位队友给你打了气"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週小隊已練 %1$@/%2$@ 次 · 今天有 %3$@ 位隊友幫你加油"
          }
        }
      }
    },
    "push.dailyProgress.poke": {
      "comment": "Push notification (APNs loc-key); the API sends the arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ gave you a pat · squad's at %1$@/%2$@ this week"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@拍了拍你 · 本周小队已练 %1$@/%2$@ 次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@拍了拍你 · 本週小隊已練 %1$@/%2$@ 次"
          }
        }
      }
    },
    "push.dailyProgress.poke.more": {
      "comment": "Push notification (APNs loc-key); the API sends the arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ and %4$@ more gave you a pat · squad's at %1$@/%2$@ this week"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@和另外 %4$@ 人拍了拍你 · 本周小队已练 %1$@/%2$@ 次"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@和另外 %4$@ 人拍了拍你 · 本週小隊已練 %1$@/%2$@ 次"
          }
        }
      }
    },
    "push.weeklyAwards.ready": {
      "comment": "Push notification (APNs loc-key); the API sends the arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This week's awards are in. Come see what you won"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本周颁奖出炉了，快来看看你拿了什么"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本週頒獎出爐了，快來看看你拿了什麼"
          }
        }
      }
    },
    "push.weeklyAwards.stuck": {
      "comment": "Push notification (APNs loc-key); the API sends the arguments.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@'s awards are stuck: %2$@ tries, last one %3$@. Time to top up"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的本周颁奖卡住了：试了 %2$@ 次，最后一次是 %3$@。去充个值吧"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 的本週頒獎卡住了：試了 %2$@ 次，最後一次是 %3$@。去儲值吧"
          }
        }
      }
    },
    "加载中": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載入中"
          }
        }
      }
    }
  },
  "version": "1.0"
}
