{
  "openapi": "3.1.0",
  "info": {
    "title": "Wildcard API",
    "version": "1",
    "description": "The only way into Wildcard’s data. Every JSON body carries a top-level `version`; every failure is an RFC 9457 problem with a stable `reason`."
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "A Supabase Auth access token."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "version",
          "status"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "about:blank"
            ]
          },
          "title": {
            "type": "string",
            "description": "The HTTP reason phrase.",
            "example": "Unauthorized"
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status code.",
            "example": 401
          },
          "detail": {
            "type": "string",
            "description": "One sentence for people. Never shown as is in the app."
          },
          "reason": {
            "type": "string",
            "description": "The exact failure. Never reworded once released; clients match on it.",
            "example": "AUTH_TOKEN_INVALID"
          },
          "errorStatus": {
            "type": "string",
            "description": "The general kind of failure, from a fixed list.",
            "example": "UNAUTHENTICATED"
          }
        },
        "required": [
          "version",
          "type",
          "title",
          "status",
          "detail",
          "reason",
          "errorStatus"
        ],
        "additionalProperties": false
      },
      "Me": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "The signed-in member’s Supabase Auth user id."
          }
        },
        "required": [
          "version",
          "userId"
        ],
        "additionalProperties": false
      },
      "CheckIn": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer",
                "enum": [
                  1
                ]
              },
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "member": {
                "type": "string",
                "format": "uuid",
                "description": "The member who made it."
              },
              "day": {
                "type": "string",
                "format": "date",
                "description": "The member’s local day it counts for."
              },
              "createdAt": {
                "type": "string",
                "format": "date-time",
                "description": "When the member made it, in UTC with milliseconds.",
                "example": "2026-10-18T14:03:00.000Z"
              },
              "audience": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "The squads it went to, in the member’s order. On someone else’s check-in, only the viewer’s own squads are listed."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "trained"
                ]
              },
              "training": {
                "type": "object",
                "properties": {
                  "sport": {
                    "type": "string",
                    "enum": [
                      "run",
                      "walk",
                      "hike",
                      "trailRun",
                      "strength",
                      "crossfit",
                      "hyrox",
                      "kettlebell",
                      "spin",
                      "elliptical",
                      "rowing",
                      "hiit",
                      "jumpRope",
                      "aerobics",
                      "yoga",
                      "matPilates",
                      "reformerPilates",
                      "barre",
                      "stretching",
                      "swim",
                      "surf",
                      "paddleboard",
                      "kayak",
                      "tennis",
                      "badminton",
                      "pickleball",
                      "tableTennis",
                      "squash",
                      "basketball",
                      "soccer",
                      "volleyball",
                      "golf",
                      "baseballSoftball",
                      "ultimate",
                      "roadCycling",
                      "mountainBiking",
                      "climb",
                      "ski",
                      "snowboard",
                      "skate",
                      "boxing",
                      "kickboxing",
                      "jiuJitsu",
                      "martialArts",
                      "dance",
                      "dogWalk",
                      "walkCommute",
                      "bikeCommute",
                      "deepClean",
                      "moving",
                      "strollerWalk",
                      "gardening",
                      "custom"
                    ]
                  },
                  "customSport": {
                    "type": "string",
                    "maxLength": 1000,
                    "description": "Trimmed, then 1 to 20 characters as people see them, on one line."
                  },
                  "caption": {
                    "type": "string",
                    "maxLength": 1000,
                    "description": "Trimmed, then 1 to 60 characters as people see them, on one line."
                  },
                  "photos": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "path": {
                          "type": "string",
                          "description": "The photo’s name, as the check-in was saved with."
                        },
                        "url": {
                          "type": "string",
                          "format": "uri",
                          "description": "`GET` the photo here. It works for an hour."
                        }
                      },
                      "required": [
                        "path",
                        "url"
                      ],
                      "additionalProperties": false
                    },
                    "description": "1 to 3 photos, the cover first. Missing when there are none."
                  }
                },
                "required": [
                  "sport"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "version",
              "id",
              "member",
              "day",
              "createdAt",
              "audience",
              "kind",
              "training"
            ],
            "additionalProperties": false
          },
