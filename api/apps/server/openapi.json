                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "care"
                ]
              }
            },
            "required": [
              "version",
              "kind"
            ],
            "additionalProperties": false,
            "description": "The reason speaks of self-harm. No drafts: show the member the care line and the 988 buttons. Nobody else sees anything."
          },
          {
            "type": "object",
            "properties": {
              "version": {
                "type": "integer",
                "enum": [
                  1
                ]
              },
              "kind": {
                "type": "string",
                "enum": [
                  "declined"
                ]
              }
            },
            "required": [
              "version",
              "kind"
            ],
            "additionalProperties": false,
            "description": "The AI doesn’t write about this reason. Show the dice suggestions."
          }
        ]
      },
      "DisclaimerDraftRequest": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "reason": {
            "type": "string",
            "maxLength": 800,
            "description": "Why the member didn’t train today, as they typed it: 1 to 100 characters. Only this and the style go to the AI, never names, photos or squads.",
            "example": "早上没起来"
          },
          "style": {
            "type": "string",
            "enum": [
              "funny",
              "unhinged",
              "heroic",
              "stubborn"
            ],
            "description": "funny 搞笑, unhinged 发疯, heroic 中二 or stubborn 嘴硬."
          }
        },
        "required": [
          "version",
          "reason",
          "style"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
