          "stretching",
          "swim",
          "surf",
          "paddleboard",
          "kayak",
          "tennis",
          "badminton",
          "pickleball",
          "tableTennis",
          "squash",
          "basketball",
          "soccer",
          "volleyball",
          "golf",
          "baseballSoftball",
          "ultimate",
          "roadCycling",
          "mountainBiking",
          "climb",
          "ski",
          "snowboard",
          "skate",
          "boxing",
          "kickboxing",
          "jiuJitsu",
          "martialArts",
          "dance",
          "dogWalk",
          "walkCommute",
          "bikeCommute",
          "deepClean",
          "moving",
          "strollerWalk",
          "gardening",
          "custom"
        ],
        "description": "A listed sport, or `custom` with the member’s own name in `customSport`."
      },
      "PhotoView": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "description": "The photo’s name, as the check-in was saved with."
          },
          "url": {
            "type": "string",
            "format": "uri",
            "description": "`GET` the photo here. It works for an hour."
          }
        },
        "required": [
          "path",
          "url"
        ],
        "additionalProperties": false
      },
