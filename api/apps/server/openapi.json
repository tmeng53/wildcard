            "type": "string",
            "format": "date-time"
          },
          "audience": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "minItems": 1,
            "maxItems": 3
          },
          "kind": {
            "type": "string",
            "enum": [
              "trained"
            ]
          },
          "training": {
            "$ref": "#/components/schemas/Training"
