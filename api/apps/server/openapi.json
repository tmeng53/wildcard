{
  "openapi": "3.1.0",
  "info": {
    "title": "Wildcard API",
    "version": "1",
    "description": "The only way into Wildcard’s data. Every JSON body carries a top-level `version`; every failure is an RFC 9457 problem with a stable `reason`."
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "A Supabase Auth access token."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "version",
          "status"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "about:blank"
            ]
          },
          "title": {
            "type": "string",
            "description": "The HTTP reason phrase.",
            "example": "Unauthorized"
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status code.",
            "example": 401
          },
          "detail": {
            "type": "string",
            "description": "One sentence for people. Never shown as is in the app."
          },
          "reason": {
            "type": "string",
            "description": "The exact failure. Never reworded once released; clients match on it.",
            "example": "AUTH_TOKEN_INVALID"
          },
          "errorStatus": {
            "type": "string",
            "description": "The general kind of failure, from a fixed list.",
            "example": "UNAUTHENTICATED"
          }
        },
        "required": [
          "version",
          "type",
          "title",
          "status",
          "detail",
          "reason",
          "errorStatus"
        ],
        "additionalProperties": false
      },
      "Me": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "The signed-in member’s Supabase Auth user id."
          },
          "profile": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "timeZone": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(\\/[A-Za-z0-9_+-]+)*$",
                "description": "The member’s IANA time zone (iOS: `TimeZone.current.identifier`), for their weekly reset.",
                "example": "America/Los_Angeles"
              }
            },
            "required": [
              "timeZone"
            ],
            "additionalProperties": false,
            "description": "Null until the member first saves one, right after signing up."
          }
        },
        "required": [
          "version",
          "userId",
          "profile"
        ],
        "additionalProperties": false
      },
      "Profile": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "timeZone": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_+-]*(\\/[A-Za-z0-9_+-]+)*$",
            "description": "The member’s IANA time zone (iOS: `TimeZone.current.identifier`), for their weekly reset.",
            "example": "America/Los_Angeles"
          }
        },
        "required": [
          "version",
          "timeZone"
        ],
        "additionalProperties": false
      },
      "CheckIn": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/TrainedCheckIn"
          },
          {
            "$ref": "#/components/schemas/HealthyMealCheckIn"
          },
          {
            "$ref": "#/components/schemas/CheatMealCheckIn"
          },
          {
            "$ref": "#/components/schemas/DisclaimerCheckIn"
          }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "trained": "#/components/schemas/TrainedCheckIn",
            "healthyMeal": "#/components/schemas/HealthyMealCheckIn",
            "cheatMeal": "#/components/schemas/CheatMealCheckIn",
            "disclaimer": "#/components/schemas/DisclaimerCheckIn"
          }
        }
      },
      "TrainedCheckIn": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "member": {
            "type": "string",
            "format": "uuid",
            "description": "The member who made it."
          },
          "day": {
            "type": "string",
            "format": "date",
            "description": "The member’s local day it counts for."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "When the member made it, in UTC with milliseconds.",
            "example": "2026-10-18T14:03:00.000Z"
          },
          "audience": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "The squads it went to, in the member’s order. On someone else’s check-in, only the viewer’s own squads are listed."
          },
          "kind": {
            "type": "string",
            "enum": [
              "trained"
            ]
          },
          "training": {
            "$ref": "#/components/schemas/TrainingView"
          }
        },
        "required": [
          "version",
          "id",
          "member",
          "day",
          "createdAt",
          "audience",
          "kind",
          "training"
        ],
        "additionalProperties": false
      },
      "TrainingView": {
        "type": "object",
        "properties": {
          "sport": {
            "$ref": "#/components/schemas/Sport"
          },
          "customSport": {
            "type": "string",
            "maxLength": 1000,
            "description": "Trimmed, then 1 to 20 characters as people see them, on one line.",
            "x-max-characters": 20
          },
          "caption": {
            "type": "string",
            "maxLength": 1000,
            "description": "Trimmed, then 1 to 60 characters as people see them, on one line.",
            "x-max-characters": 60
          },
          "photos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PhotoView"
            },
            "description": "1 to 3 photos, the cover first. Missing when there are none."
          }
        },
        "required": [
          "sport"
        ],
        "additionalProperties": false
      },
      "Sport": {
        "type": "string",
        "enum": [
          "run",
          "walk",
          "hike",
          "trailRun",
          "strength",
