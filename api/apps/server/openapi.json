{
  "openapi": "3.1.0",
  "info": {
    "title": "Wildcard API",
    "version": "1",
    "description": "The only way into Wildcard’s data. Every JSON body carries a top-level `version`; every failure is an RFC 9457 problem with a stable `reason`."
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "A Supabase Auth access token."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          }
        },
        "required": [
          "version",
          "status"
        ],
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "type": {
            "type": "string",
            "enum": [
              "about:blank"
            ]
          },
          "title": {
            "type": "string",
            "description": "The HTTP reason phrase.",
            "example": "Unauthorized"
          },
          "status": {
            "type": "integer",
            "description": "The HTTP status code.",
            "example": 401
          },
          "detail": {
            "type": "string",
            "description": "One sentence for people. Never shown as is in the app."
          },
          "reason": {
            "type": "string",
            "description": "The exact failure. Never reworded once released; clients match on it.",
            "example": "AUTH_TOKEN_INVALID"
          },
          "errorStatus": {
            "type": "string",
            "description": "The general kind of failure, from a fixed list.",
            "example": "UNAUTHENTICATED"
          }
        },
        "required": [
          "version",
          "type",
          "title",
          "status",
          "detail",
          "reason",
          "errorStatus"
        ],
        "additionalProperties": false
      },
      "Me": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "The signed-in member’s Supabase Auth user id."
          }
        },
        "required": [
          "version",
          "userId"
        ],
        "additionalProperties": false
      },
      "PhotoUpload": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "path": {
            "type": "string",
            "description": "The photo’s name, `<member id>/<photo id>`. A check-in lists it in `photos` once the upload is done.",
            "example": "3f0c8a52-6f39-4c39-9a51-0c7c3c4a4f1e/9b2e1d4c-7a8f-4e2b-8c1d-2f3a4b5c6d7e"
          },
          "uploadUrl": {
            "type": "string",
            "format": "uri",
            "description": "Upload the photo here with `PUT`, the file as the body and its `Content-Type` (JPEG, HEIC, PNG or WebP, at most 10 MiB). It works for 2 hours and only once."
          }
        },
        "required": [
          "version",
          "path",
          "uploadUrl"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Whether the API can reach its database",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "The database is unreachable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "The signed-in member",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "No bearer token, or not a valid one",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Sign-in can’t be checked right now",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/photo-uploads": {
      "post": {
        "operationId": "createPhotoUpload",
        "summary": "A signed URL to upload one check-in photo to",
        "security": [
          {
            "bearer": []
          }
        ],
        "responses": {
          "201": {
            "description": "Ready to upload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhotoUpload"
                }
              }
            }
          },
          "401": {
            "description": "No bearer token, or not a valid one",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "Sign-in or photo storage can’t be reached right now",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
