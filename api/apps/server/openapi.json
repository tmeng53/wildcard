      "PhotoUpload": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "path": {
            "type": "string",
            "description": "The photo’s name, `<member id>/<photo id>`. A check-in lists it in `photos` once the upload is done.",
            "example": "3f0c8a52-6f39-4c39-9a51-0c7c3c4a4f1e/9b2e1d4c-7a8f-4e2b-8c1d-2f3a4b5c6d7e"
          },
          "uploadUrl": {
            "type": "string",
            "format": "uri",
            "description": "Upload the photo here with `PUT`, the file as the body and its `Content-Type` (JPEG, HEIC, PNG or WebP, at most 10 MiB). It works for 2 hours and only once."
          }
        },
        "required": [
          "version",
          "path",
          "uploadUrl"
        ],
        "additionalProperties": false
      },
      "SquadToday": {
        "type": "object",
        "properties": {
          "version": {
            "type": "integer",
            "enum": [
              1
            ]
          },
          "squad": {
            "type": "string",
            "format": "uuid"
          },
          "members": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "member": {
                  "type": "string",
                  "format": "uuid"
                },
                "day": {
                  "type": "string",
                  "format": "date",
                  "description": "The member’s own today: their local date in their time zone, where anything before 3am still counts for the day before."
                },
                "training": {
                  "type": "string",
                  "enum": [
                    "trained",
                    "disclaimer",
                    "notCheckedIn"
                  ],
                  "description": "Where their today stands, from check-ins sent to this squad. A 练了 wins over a 免责声明 posted earlier the same day."
                },
                "latestMeal": {
                  "type": "string",
                  "enum": [
                    "healthyMeal",
                    "cheatMeal"
                  ],
                  "description": "Their latest meal today sent to this squad. Missing when none."
                }
              },
              "required": [
                "member",
                "day",
                "training"
              ],
              "additionalProperties": false
            },
            "description": "Everyone in the squad now, the signed-in member included, in join order."
          },
          "today": {
            "type": "object",
            "properties": {
              "trained": {
                "type": "integer",
                "minimum": 0,
                "description": "Members whose today is trained."
              },
              "disclaimer": {
                "type": "integer",
                "minimum": 0,
                "description": "Members whose today is a 免责声明 with no 练了."
              },
              "everyoneTrained": {
                "type": "boolean",
                "description": "Every member’s today is trained."
              }
            },
            "required": [
              "trained",
              "disclaimer",
              "everyoneTrained"
            ],
            "additionalProperties": false
          },
          "me": {
            "type": "object",
            "properties": {
              "week": {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "string",
                    "format": "date"
                  },
                  "to": {
                    "type": "string",
                    "format": "date"
                  },
                  "trainedDays": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Days this week with a 练了, wherever it was sent. Several on one day count once."
                  }
                },
                "required": [
                  "from",
                  "to",
                  "trainedDays"
                ],
                "additionalProperties": false
              },
              "lifetimeTrainedDays": {
                "type": "integer",
                "minimum": 0,
                "description": "Days ever with a 练了."
              }
            },
            "required": [
              "week",
              "lifetimeTrainedDays"
            ],
            "additionalProperties": false
          },
          "squadWeek": {
            "type": "object",
            "properties": {
              "trainedDays": {
                "type": "integer",
                "minimum": 0,
                "description": "Days trained this week, added up over the members, each in their own week and from check-ins sent to this squad."
              }
            },
            "required": [
              "trainedDays"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "version",
          "squad",
          "members",
          "today",
          "me",
          "squadWeek"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
